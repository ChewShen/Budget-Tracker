# Supabase Configuration
# The public key: "publishable" (sb_publishable_...) on new projects, "anon" on older ones.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here

# Optional, server only (never NEXT_PUBLIC_): lets the nightly reminders job read each account's data.
# Supabase -> Project Settings -> API Keys -> Secret keys -> default (sb_secret_...), or on older
# projects the legacy service_role key. Bypasses RLS, so keep it out of the browser and out of git.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key-here

# Reminders (optional, see README > Reminders). Generate with: npx web-push generate-vapid-keys
# The nightly job needs these three plus SUPABASE_SERVICE_ROLE_KEY above; "Send a test" only
# needs the two VAPID keys. On Vercel, set them for Production and redeploy.
# CRON_SECRET: any long random string, e.g. from `openssl rand -hex 32`.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# CRON_SECRET=
